<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="io.github.composefluent.winrt.gallery.controls.ControlExample"
             Margin="0,16,0,0">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../GalleryExampleResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock x:Name="headerTextPresenter" Margin="0,0,0,12"
                   Style="{StaticResource GalleryExampleTitleStyle}" />
        <Grid Style="{StaticResource GalleryExampleBodyStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Padding="12" MinHeight="80">
                <ContentPresenter x:Name="examplePresenter" />
            </Border>
            <StackPanel Grid.Column="1" Padding="16" MaxWidth="320" Margin="0,12,12,12"
                        CornerRadius="8" Spacing="8"
                        Background="{ThemeResource GalleryExampleBackground}">
                <TextBlock Text="Output:" TextWrapping="Wrap" />
                <ContentPresenter x:Name="outputPresenter" />
            </StackPanel>
            <Border Grid.Column="2" Padding="16" MaxWidth="320"
                    BorderThickness="1,0,0,0" CornerRadius="0,8,0,0"
                    Background="{ThemeResource GalleryOptionsBackground}"
                    BorderBrush="{ThemeResource GalleryOptionsBorder}">
                <ContentPresenter x:Name="optionsPresenter" />
            </Border>
        </Grid>
        <Expander x:Name="sourcePresenter" Header="Show code"
                  Style="{StaticResource GalleryExampleSourceStyle}" />
    </StackPanel>
</UserControl>
