<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="io.github.composefluent.winrt.gallery.basicinput.ToggleSwitchPage">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../GalleryExampleResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <StackPanel>
        <StackPanel x:Name="simpleExample" Margin="0,16,0,0">
            <TextBlock Text="A simple ToggleSwitch." Style="{StaticResource GalleryExampleTitleStyle}" />
            <Grid x:Name="simpleBody" Style="{StaticResource GalleryExampleBodyStyle}">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Padding="12" MinHeight="80">
                    <ToggleSwitch x:Name="simpleToggle" />
                </Border>
            </Grid>
            <Expander x:Name="simpleSource" Style="{StaticResource GalleryExampleSourceStyle}" />
        </StackPanel>
        <StackPanel x:Name="workExample" Margin="0,16,0,0">
            <TextBlock Text="A ToggleSwitch with custom content." Style="{StaticResource GalleryExampleTitleStyle}" />
            <Grid x:Name="workBody" Style="{StaticResource GalleryExampleBodyStyle}">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Padding="12" MinHeight="80">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ToggleSwitch x:Name="workToggle" Header="Toggle work" IsOn="True" OffContent="Do work" OnContent="Working" Toggled="onWorkToggled" />
                        <ProgressRing x:Name="progress" Width="32" IsActive="True" />
                    </StackPanel>
                </Border>
            </Grid>
            <Expander x:Name="workSource" Style="{StaticResource GalleryExampleSourceStyle}" />
        </StackPanel>
    </StackPanel>
</Page>
