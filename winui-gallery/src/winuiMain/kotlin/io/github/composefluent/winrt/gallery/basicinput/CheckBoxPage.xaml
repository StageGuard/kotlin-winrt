<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="io.github.composefluent.winrt.gallery.basicinput.CheckBoxPage">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../GalleryExampleResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <StackPanel>
        <StackPanel x:Name="twoStateExample" Margin="0,16,0,0">
            <TextBlock Text="A two-state CheckBox." Style="{StaticResource GalleryExampleTitleStyle}" />
            <Grid x:Name="twoStateBody" Style="{StaticResource GalleryExampleBodyStyle}">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Padding="12" MinHeight="80">
                    <CheckBox x:Name="twoStateCheckBox" Content="Two-state CheckBox" Click="onTwoStateClick" />
                </Border>
                <StackPanel Grid.Column="1" Padding="16" MaxWidth="320" Margin="0,12,12,12" CornerRadius="8"
                            Spacing="8" Background="{ThemeResource GalleryExampleBackground}">
                    <TextBlock Text="Output:" TextWrapping="Wrap" />
                    <TextBlock x:Name="twoStateOutput" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <Expander x:Name="twoStateSource" Style="{StaticResource GalleryExampleSourceStyle}" />
        </StackPanel>
        <StackPanel x:Name="threeStateExample" Margin="0,16,0,0">
            <TextBlock Text="A three-state CheckBox." Style="{StaticResource GalleryExampleTitleStyle}" />
            <Grid x:Name="threeStateBody" Style="{StaticResource GalleryExampleBodyStyle}">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Padding="12" MinHeight="80">
                    <CheckBox x:Name="threeStateCheckBox" Content="Three-state CheckBox" IsThreeState="True" Click="onThreeStateClick" />
                </Border>
                <StackPanel Grid.Column="1" Padding="16" MaxWidth="320" Margin="0,12,12,12" CornerRadius="8"
                            Spacing="8" Background="{ThemeResource GalleryExampleBackground}">
                    <TextBlock Text="Output:" TextWrapping="Wrap" />
                    <TextBlock x:Name="threeStateOutput" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <Expander x:Name="threeStateSource" Style="{StaticResource GalleryExampleSourceStyle}" />
        </StackPanel>
        <StackPanel x:Name="selectAllExample" Margin="0,16,0,0">
            <TextBlock Text="Using a three-state CheckBox as a Select all control." Style="{StaticResource GalleryExampleTitleStyle}" />
            <Grid x:Name="selectAllBody" Style="{StaticResource GalleryExampleBodyStyle}">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Padding="12" MinHeight="80">
                    <StackPanel>
                        <CheckBox x:Name="allOptions" Content="Select all" IsThreeState="True" IsChecked="{x:Null}" Click="onSelectAllClick" />
                        <CheckBox x:Name="option1" Content="Option 1" Margin="24,0,0,0" Click="onOptionClick" />
                        <CheckBox x:Name="option2" Content="Option 2" Margin="24,0,0,0" IsChecked="True" Click="onOptionClick" />
                        <CheckBox x:Name="option3" Content="Option 3" Margin="24,0,0,0" Click="onOptionClick" />
                    </StackPanel>
                </Border>
            </Grid>
            <Expander x:Name="selectAllSource" Style="{StaticResource GalleryExampleSourceStyle}" />
        </StackPanel>
    </StackPanel>
</Page>
