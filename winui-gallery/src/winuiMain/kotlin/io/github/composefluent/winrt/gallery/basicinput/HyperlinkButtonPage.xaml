<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:io.github.composefluent.winrt.gallery.controls"
      x:Class="io.github.composefluent.winrt.gallery.basicinput.HyperlinkButtonPage">
    <StackPanel>
        <controls:ControlExample x:Name="Example1" SampleDefinition="HyperlinkButton\HyperlinkButtonNavigate.txt">
            <controls:ControlExample.Example>
                <HyperlinkButton x:Name="Control1" Content="Microsoft home page"
                                 NavigateUri="https://www.microsoft.com" />
            </controls:ControlExample.Example>
            <controls:ControlExample.Options>
                <StackPanel>
                    <CheckBox x:Name="DisableControl1" Content="Disable hyperlink button"
                              Click="DisableControl1_Click" />
                </StackPanel>
            </controls:ControlExample.Options>
        </controls:ControlExample>
        <controls:ControlExample SampleDefinition="HyperlinkButton\HyperlinkButtonClick.txt">
            <controls:ControlExample.Example>
                <HyperlinkButton x:Name="Control2" Click="GoToHyperlinkButton_Click"
                                 Content="Go to ToggleButton" />
            </controls:ControlExample.Example>
        </controls:ControlExample>
    </StackPanel>
</Page>
