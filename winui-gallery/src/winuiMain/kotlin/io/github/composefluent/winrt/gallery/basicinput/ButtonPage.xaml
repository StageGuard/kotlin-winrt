<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="io.github.composefluent.winrt.gallery.basicinput.ButtonPage">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../GalleryExampleResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <StackPanel>
        <StackPanel x:Name="textExample" Margin="0,16,0,0">
            <TextBlock Text="A simple Button with text content." Style="{StaticResource GalleryExampleTitleStyle}" />
            <Grid x:Name="textBody" Style="{StaticResource GalleryExampleBodyStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Padding="12" MinHeight="80">
                    <Button x:Name="standardButton" AutomationProperties.Name="Standard XAML" Content="Standard XAML button" Click="onStandardClick" />
                </Border>
                <StackPanel Grid.Column="1" Padding="16" MaxWidth="320" Margin="0,12,12,12" CornerRadius="8"
                            Spacing="8" Background="{ThemeResource GalleryExampleBackground}">
                    <TextBlock Text="Output:" TextWrapping="Wrap" />
                    <TextBlock x:Name="textOutput" TextWrapping="Wrap" />
                </StackPanel>
                <Border x:Name="textOptions" Grid.Column="2" Padding="16" MaxWidth="320"
                        BorderThickness="1,0,0,0" CornerRadius="0,8,0,0"
                        Background="{ThemeResource GalleryOptionsBackground}"
                        BorderBrush="{ThemeResource GalleryOptionsBorder}">
                    <CheckBox x:Name="disableButton" Content="Disable button" Click="onDisableClick" />
                </Border>
            </Grid>
            <Expander x:Name="textSource" Style="{StaticResource GalleryExampleSourceStyle}" />
        </StackPanel>
        <StackPanel x:Name="imageExample" Margin="0,16,0,0">
            <TextBlock Text="A Button with image content." Style="{StaticResource GalleryExampleTitleStyle}" />
            <Grid x:Name="imageBody" Style="{StaticResource GalleryExampleBodyStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Padding="12" MinHeight="80">
                    <Button x:Name="imageButton" Width="50" Height="50" AutomationProperties.Name="Pie" Click="onImageClick">
                        <Image AutomationProperties.Name="Slice" Source="/Assets/SampleMedia/Slices.png" />
                    </Button>
                </Border>
                <StackPanel Grid.Column="1" Padding="16" MaxWidth="320" Margin="0,12,12,12" CornerRadius="8"
                            Spacing="8" Background="{ThemeResource GalleryExampleBackground}">
                    <TextBlock Text="Output:" TextWrapping="Wrap" />
                    <TextBlock x:Name="imageOutput" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <Expander x:Name="imageSource" Style="{StaticResource GalleryExampleSourceStyle}" />
        </StackPanel>
        <StackPanel x:Name="stylesExample" Margin="0,16,0,0">
            <TextBlock Text="Buttons with built-in styles." Style="{StaticResource GalleryExampleTitleStyle}" />
            <Grid x:Name="stylesBody" Style="{StaticResource GalleryExampleBodyStyle}">
                <Border Padding="12" MinHeight="80">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Button x:Name="accentButton" AutomationProperties.Name="Accent style" Content="Accent style button" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="subtleButton" AutomationProperties.Name="Subtle style" Content="Subtle style button" Style="{StaticResource SubtleButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Expander x:Name="stylesSource" Style="{StaticResource GalleryExampleSourceStyle}" />
        </StackPanel>
        <StackPanel x:Name="longExample" Margin="0,16,0,0">
            <TextBlock Text="Buttons with long content." Style="{StaticResource GalleryExampleTitleStyle}" />
            <Grid x:Name="longBody" Style="{StaticResource GalleryExampleBodyStyle}">
                <Border Padding="12" MinHeight="80">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8" Text="The following buttons' content may get clipped if we don't pay careful attention to their layout containers." TextWrapping="Wrap" />
                        <TextBlock Text="One option to mitigate clipped content is to place Buttons underneath each other, allowing for more space to grow horizontally:"
                                   Margin="0,0,0,8" TextWrapping="Wrap" />
                        <Button Margin="0,0,0,5" Content="This is some text that is too long and will get cut off" HorizontalAlignment="Stretch" />
                        <Button Content="This is another text that would result in being cut off" HorizontalAlignment="Stretch" />
                        <TextBlock Margin="0,8,0,8" Text="Another option is to explicitly wrap the Button's content" TextWrapping="Wrap" />
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <Button x:Name="wrappedFirst" MaxWidth="240" Margin="0,0,8,0">
                                <TextBlock Text="This is some text that is too long and will get cut off without wrapping" TextWrapping="WrapWholeWords" />
                            </Button>
                            <Button x:Name="wrappedSecond" MaxWidth="240">
                                <TextBlock Text="This is another text that would result in being cut off without wrapping" TextWrapping="WrapWholeWords" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <Expander x:Name="longSource" Style="{StaticResource GalleryExampleSourceStyle}" />
        </StackPanel>
    </StackPanel>
</Page>
